<nav class="breadcrumbs wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {% for crumb in breadcrumbs %}
      {% if loop.last %}
        <li><span aria-current="page">{{ crumb.text }}</span></li>
      {% else %}
        <li><a href="{{ crumb.url }}">{{ crumb.text }}</a></li>
      {% endif %}
    {% endfor %}
  </ol>
</nav>
