<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <svg width="28" height="28" viewBox="0 0 32 32" role="img" aria-hidden="true" focusable="false">
        <rect width="32" height="32" rx="8" fill="#14508c"/>
        <path d="M8 22V10l8 7 8-7v12" fill="none" stroke="#fff" stroke-width="2.6"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{{ site.name }}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round"/>
      </svg>
      Menu
    </button>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <ul class="nav__list">
        {% for item in nav.primary %}
        <li>
          <a class="nav__link" href="{{ item.url }}"
             {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.text }}</a>
        </li>
        {% endfor %}
        <li><a class="btn btn--primary" href="{{ nav.cta.url }}">{{ nav.cta.text }}</a></li>
      </ul>
    </nav>
  </div>
</header>
