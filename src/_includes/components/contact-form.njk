<section class="section" id="{{ section.id or 'enquiry' }}" aria-labelledby="h-form">
  <div class="wrap">
    <div class="split">

      <div>
        <div class="section__head" style="margin-bottom:1.5rem">
          {% if section.eyebrow %}<p class="eyebrow">{{ section.eyebrow }}</p>{% endif %}
          <h2 id="h-form">{{ section.heading }}</h2>
          {% if section.intro %}<p>{{ section.intro }}</p>{% endif %}
        </div>

        {#
          A plain HTML POST with no client-side JS, so the form works with
          scripting disabled. The target is configured in _data/site.js — see
          the `form` block there for the supported providers.
        #}
        <form class="form" name="enquiry" method="POST" action="{{ site.form.action }}"
              {% if site.form.netlify %}data-netlify="true" netlify-honeypot="{{ site.form.honeypot.name }}"{% endif %}>
          {% if site.form.netlify %}<input type="hidden" name="form-name" value="enquiry">{% endif %}
          {% for field, value in site.form.hidden %}
          <input type="hidden" name="{{ field }}" value="{{ value }}">
          {% endfor %}

          {# Honeypot: visually and programmatically hidden from real users.
             Field name is provider-specific — see site.js. #}
          <p class="visually-hidden" aria-hidden="true">
            <label>Do not fill this in
              <input type="{{ site.form.honeypot.type }}" name="{{ site.form.honeypot.name }}"
                     tabindex="-1" autocomplete="off">
            </label>
          </p>

          <div class="form-row">
            <div class="field">
              <label for="name">Full name <span class="required" aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="email">Work email <span class="required" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email"
                     required aria-describedby="email-hint">
              <p class="hint" id="email-hint">We reply from a real address, usually within one working day.</p>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="company">Company</label>
              <input id="company" name="company" type="text" autocomplete="organization">
            </div>
            <div class="field">
              <label for="size">Employees in scope</label>
              <select id="size" name="size">
                <option value="">Select a range</option>
                <option>1&ndash;40</option>
                <option>41&ndash;120</option>
                <option>121&ndash;250</option>
                <option>251+</option>
              </select>
            </div>
          </div>

          <fieldset>
            <legend>What would you like to talk about?</legend>
            <div class="form-row" style="margin-top:0.5rem">
              {% for opt in [
                { id: "demo", label: "Book a demo" },
                { id: "trial", label: "Start a 14-day trial" },
                { id: "enterprise", label: "Enterprise requirements" },
                { id: "support", label: "Existing customer support" }
              ] %}
              {# The wrapper id is the deep-link target for /contact/#demo etc. #}
              <div class="checkbox" id="{{ opt.id }}">
                <input type="checkbox" id="topic-{{ opt.id }}" name="topic" value="{{ opt.label }}">
                <label for="topic-{{ opt.id }}">{{ opt.label }}</label>
              </div>
              {% endfor %}
            </div>
          </fieldset>

          <div class="field">
            <label for="message">How can we help? <span class="required" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" required
                      aria-describedby="message-hint"></textarea>
            <p class="hint" id="message-hint">
              Frameworks you are working towards, your audit deadline, and the cloud
              and identity providers you use &mdash; that is enough for a useful first call.
            </p>
          </div>

          <div class="checkbox">
            <input type="checkbox" id="consent" name="consent" value="yes" required
                   aria-describedby="consent-hint">
            <label for="consent">
              I agree to Meridian contacting me about this enquiry.
              <span class="required" aria-hidden="true">*</span>
            </label>
          </div>
          <p class="hint" id="consent-hint" style="margin:-0.6rem 0 0">
            We do not add enquiries to a marketing list. Fields marked
            <span class="required" aria-hidden="true">*</span>
            <span class="visually-hidden">with an asterisk</span> are required.
          </p>

          <div>
            <button class="btn btn--primary" type="submit">Send enquiry</button>
          </div>
        </form>
      </div>

      <div>
        <h2 class="visually-hidden">Other ways to reach us</h2>
        <dl class="detail-list">
          <dt>Sales</dt>
          <dd>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
            <a href="tel:{{ site.phone | replace(" ", "") }}">{{ site.phone }}</a>
          </dd>

          <dt>Customer support</dt>
          <dd>
            Existing customers: <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
            Scale and Enterprise plans have a four-hour and one-hour response target respectively.
          </dd>

          <dt>Security disclosure</dt>
          <dd>
            Report a vulnerability to
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
            We acknowledge within one working day.
          </dd>

          <dt>Office</dt>
          <dd>
            <address style="font-style:normal">
              {{ site.address.street }}<br>
              {{ site.address.city }} {{ site.address.postcode }}<br>
              {{ site.address.countryName }}
            </address>
          </dd>

          <dt>Hours</dt>
          <dd>{{ site.hours }}.</dd>
        </dl>
      </div>
    </div>
  </div>
</section>
