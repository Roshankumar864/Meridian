{# Inline icon set. Decorative only — every icon sits next to a text label,
   so they are aria-hidden and never announced. #}
{% macro icon(name) %}
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  {%- if name == "shield" -%}
    <path d="M12 3l7 3v5c0 4.4-2.9 8.3-7 10-4.1-1.7-7-5.6-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
  {%- elif name == "flow" -%}
    <circle cx="5" cy="6" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="18" r="2"/>
    <path d="M7 6h6a4 4 0 014 4v0M7 18h6a4 4 0 004-4v0"/>
  {%- elif name == "clock" -%}
    <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
  {%- elif name == "layers" -%}
    <path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>
  {%- elif name == "people" -%}
    <circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0112 0"/><path d="M16 5.5a3 3 0 010 5.8M17 14.5a6 6 0 014 5.5"/>
  {%- elif name == "report" -%}
    <path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h4"/>
  {%- elif name == "alert" -%}
    <path d="M12 4l9 16H3l9-16z"/><path d="M12 10v4M12 17.5h.01"/>
  {%- elif name == "vendor" -%}
    <path d="M4 9h16v11H4z"/><path d="M4 9l2-5h12l2 5"/><path d="M10 20v-6h4v6"/>
  {%- endif -%}
</svg>
{% endmacro %}
